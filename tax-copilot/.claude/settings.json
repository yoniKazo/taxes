{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Bash(python *)",
      "Bash(pytest*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "ask": [
      "Edit(**)",
      "Write(**)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(pip install*)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(more .env*)",
      "Bash(Get-Content .env*)",
      "Bash(git add .env*)",
      "Bash(git add -f .env*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_env_leak.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit_log.py\""
          }
        ]
      }
    ]
  }
}
